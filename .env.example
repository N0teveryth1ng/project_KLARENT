# Application
APP_NAME=agent-reliability-lab
DEBUG=false
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_reliability_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_reliability_lab

# Redis
REDIS_URL=redis://localhost:6379/0

# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# Execution
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2

# Artifacts
ARTIFACTS_DIR=./artifacts
